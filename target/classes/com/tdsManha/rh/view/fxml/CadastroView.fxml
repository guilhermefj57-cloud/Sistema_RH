<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="450.0" spacing="15.0"
      style="-fx-background-color: white; -fx-border-radius: 10;"
      xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tdsManha.rh.controller.CadastroController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
    </padding>

    <Label text="RH SENAC | Novo Cadastro" style="-fx-text-fill: #165491;">
        <font>
            <Font name="System Bold" size="22.0"/>
        </font>
    </Label>

    <VBox prefWidth="320.0" spacing="5.0">
        <Label text="Nome Completo:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="nomeField" promptText="Seu nome completo"
                   style="-fx-border-color: #cccccc; -fx-border-radius: 5;"/>
    </VBox>

    <VBox prefWidth="320.0" spacing="5.0">
        <Label text="E-mail:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="emailField" promptText="seuemail@exemplo.com"
                   style="-fx-border-color: #cccccc; -fx-border-radius: 5;"/>
    </VBox>

    <VBox prefWidth="320.0" spacing="5.0">
        <Label text="Senha (mínimo 8 caracteres):" style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="senhaField"
                       style="-fx-border-color: #cccccc; -fx-border-radius: 5;"/>
    </VBox>

    <VBox prefWidth="320.0" spacing="5.0">
        <Label text="Confirme a Senha:" style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="confirmaSenhaField"
                       style="-fx-border-color: #cccccc; -fx-border-radius: 5;"/>
    </VBox>

    <Button fx:id="cadastrarButton" defaultButton="true" onAction="#handleCadastroButton"
            prefWidth="120.0" text="Cadastrar"
            style="-fx-background-color: #F79633; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 5;">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
    </Button>

</VBox>
