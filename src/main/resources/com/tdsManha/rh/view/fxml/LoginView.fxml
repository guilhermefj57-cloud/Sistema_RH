<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="400.0" spacing="20.0"
      style="-fx-background-color: white; -fx-border-radius: 10;"
      xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tdsManha.rh.controller.LoginController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
    </padding>

    <Label text="RH SENAC | Login" style="-fx-text-fill: #165491;">
        <font>
            <Font name="System Bold" size="24.0"/>
        </font>
    </Label>

    <Label fx:id="statusLabel" textFill="RED" style="-fx-font-weight: bold;"/>

    <VBox prefWidth="320.0" spacing="5.0">
        <Label text="E-mail:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="emailField" promptText="seuemail@exemplo.com"
                   style="-fx-border-color: #cccccc; -fx-border-radius: 5;"/>
    </VBox>

    <VBox prefWidth="320.0" spacing="5.0">
        <Label text="Senha:" style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="senhaField"
                       style="-fx-border-color: #cccccc; -fx-border-radius: 5;"/>
    </VBox>

    <Button fx:id="loginButton" defaultButton="true" onAction="#handleLoginButton"
            prefWidth="120.0" text="Login"
            style="-fx-background-color: #F79633; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 5;"/>

    <Hyperlink onAction="#handleRegisterLink"
               text="Não tem uma conta? Cadastre-se"
               style="-fx-text-fill: #165491;"/>

</VBox>
