<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<GridPane hgap="20.0" vgap="20.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tdsManha.rh.controller.DashboardController">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" prefHeight="250.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
    </rowConstraints>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <VBox style="-fx-background-color: white; -fx-background-radius: 10;" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>
        <effect>
            <DropShadow radius="5.0" height="10.0" width="10.0">
                <color>
                    <Color opacity="0.08" />
                </color>
            </DropShadow>
        </effect>

        <Label text="Métricas da Equipe" style="-fx-text-fill: #165491;">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <HBox alignment="CENTER_LEFT" spacing="20.0" VBox.vgrow="ALWAYS">
            <VBox alignment="CENTER" style="-fx-background-color: #FCC284; -fx-padding: 15; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                <Label text="Total de Colaboradores" />
                <Label fx:id="totalColaboradoresLabel" text="7">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>
            </VBox>
            <VBox alignment="CENTER" style="-fx-background-color: #00BD6B; -fx-padding: 15; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                <Label text="Ativos" style="-fx-text-fill: #FFFFFF;" />
                <Label fx:id="ativosLabel" text="5" style="-fx-text-fill: #FFFFFF;">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>
            </VBox>
            <VBox alignment="CENTER" style="-fx-background-color: #D82F00; -fx-padding: 15; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                <Label text="Inativos" style="-fx-text-fill: #FFFFFF;" />
                <Label fx:id="inativosLabel" text="2" style="-fx-text-fill: #FFFFFF;">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>
            </VBox>
        </HBox>
    </VBox>

    <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10;" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>
        <effect>
            <DropShadow radius="5.0" height="10.0" width="10.0">
                <color>
                    <Color opacity="0.08" />
                </color>
            </DropShadow>
        </effect>
        <Label text="Colaboradores por Departamento" style="-fx-text-fill: #165491;">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <PieChart fx:id="departamentoPieChart" legendVisible="true" VBox.vgrow="ALWAYS" />
    </VBox>

    <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10;" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>
        <effect>
            <DropShadow radius="5.0" height="10.0" width="10.0">
                <color>
                    <Color opacity="0.08" />
                </color>
            </DropShadow>
        </effect>
        <Label text="Próximos Aniversários de Empresa (30 dias)" style="-fx-text-fill: #165491;">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <ListView fx:id="aniversariantesListView" VBox.vgrow="ALWAYS" />
    </VBox>

    <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10;" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>
        <effect>
            <DropShadow radius="5.0" height="10.0" width="10.0">
                <color>
                    <Color opacity="0.08" />
                </color>
            </DropShadow>
        </effect>
        <Label text="Colaboradores em Férias Hoje" style="-fx-text-fill: #165491;">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <ListView fx:id="feriasListView" VBox.vgrow="ALWAYS" />
    </VBox>
</GridPane>